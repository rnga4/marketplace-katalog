# Salin ke .env lalu sesuaikan. Semua variabel punya default (aman tanpa .env).

# URL publik (canonical/OG/sitemap). WAJIB sama dengan URL di browser saat pakai tunnel,
# mis. https://hp.domainkamu.com — supaya login POST tidak kena "Cross-site POST forbidden".
SITE_URL=http://localhost:8096

# Opsional: pola host tambahan untuk Astro security.allowedDomains (wildcard Astro).
# Contoh quick tunnel Cloudflare: SECURITY_ALLOWED_HOST=**.trycloudflare.com
# SECURITY_ALLOWED_HOST=

# Port publik yang dibind web di host (8096 bebas, jangan bentrok dengan service lain).
PUBLIC_HTTP_PORT=8096

# --- Database -----------------------------------------------------------------
# WAJIB diisi. Dipakai untuk membuat container Postgres dan untuk menyambung
# aplikasi ke sana lewat DATABASE_URL. Hanya huruf dan angka: password ikut
# disisipkan ke URL dan karakter khusus harus di-URL-encode manual.
# Buat dengan: openssl rand -hex 24
POSTGRES_PASSWORD=

# Nama database dan pengguna. Boleh diganti, tapi baris yang sudah terlanjur
# dibuat di volume db-data tidak ikut berubah.
POSTGRES_DB=hpsecond
POSTGRES_USER=hpsecond

# Menjalankan di luar Docker (npm run dev, astro check, skrip migrasi) berarti
# Compose tidak menyusun DATABASE_URL untukmu, jadi isi sendiri. Penyesuaian
# password di atas harus ikut di-URL-encode di sini.
# DATABASE_URL=postgres://hpsecond:PASSWORD@127.0.0.1:5432/hpsecond

# Jumlah koneksi Postgres yang dibuka aplikasi. Bawaan 10 sudah cukup; satu
# instance aplikasi cuma memakai satu core untuk JavaScript, jadi pool lebih
# besar hanya menggeser antrean ke Postgres tanpa menambah throughput.
# DATABASE_POOL_MAX=10

# Kata sandi admin. Bila kosong, dibuat acak saat DB pertama dibuat
# dan dicetak sekali di log container (docker compose logs app).
ADMIN_PASSWORD=ganti-sandi-panjang-kuat

# Rahasia penandatangan sesi. BIARKAN KOSONG: nilainya dibaca dari baris
# session_secret di Postgres, dibuat otomatis sekali lalu disimpan di sana.
#
# Mengisi ini hanya berguna untuk hal yang tidak ada di sini, misalnya
# menjalankan dua situs terhadap satu Postgres yang sama. Kalau diisi, nilainya
# yang menang dan baris di database jadi tidak berlaku -- dua sumber kebenaran
# untuk satu nilai, dan persis itu yang dulu membuat semua orang logout ketika
# database dipindahkan.
# SESSION_SECRET=

# Kontak penjual (ganti sebelum go-live, ada juga di src/data/site.ts).
# WHATSAPP=6280000000000

# Untuk profile `tunnel`: isi token Zero Trust Tunnel dari Cloudflare dashboard.
# TUNNEL_TOKEN=