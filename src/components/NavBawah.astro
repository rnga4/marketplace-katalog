---
import { ambilSite } from '../lib/db';
import { linkWa } from '../data/site';
import { bacaSesi } from '../lib/auth';

const site = ambilSite();
const wa = linkWa(undefined, site.whatsapp, site.nama);
const pemilik = bacaSesi(Astro.cookies) !== null;

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const diDetail = path.startsWith('/hp/');

type Tab = {
  key: string;
  label: string;
  href: string;
  ikon: 'rumah' | 'katalog' | 'chat' | 'roda';
  aktif?: boolean;
};

/* Dua tab pertama menunjuk ke satu dokumen yang sama: Beranda ke bagian atas
   halaman, Katalog ke grid di bawahnya. Karena itu tab aktif ikut bergeser
   waktu digulir, bukan ditentukan sekali di server. */
const TABS: Tab[] = [
  { key: 'beranda', label: 'Beranda', href: '/', ikon: 'rumah', aktif: !diDetail },
  { key: 'katalog', label: 'Katalog', href: '/#katalog', ikon: 'katalog', aktif: diDetail },
];

/* Dua tab sisanya tidak selalu ada. WhatsApp disembunyikan kalau nomor belum
   diisi seller, Kelola hanya untuk pemilik yang sudah masuk, supaya tidak ada
   tab yang mengarah ke halaman yang tidak bisa dibuka. */
if (wa) TABS.push({ key: 'wa', label: 'WhatsApp', href: wa, ikon: 'chat' });
if (pemilik) TABS.push({ key: 'kelola', label: 'Kelola', href: '/admin', ikon: 'roda' });
---

<nav class="nav-bawah md:hidden" aria-label="Navigasi bawah">
  <ul class="mx-auto flex max-w-lg items-stretch px-1.5">
    {
      TABS.map((tab) => (
        <li class="flex-1">
          <a
            href={tab.href}
            data-tab={tab.key}
            aria-current={tab.aktif ? 'page' : false}
            class="target-sentuh flex h-full flex-col items-center justify-center gap-1 px-1 py-2 text-[0.6875rem] font-medium leading-tight text-stone-600"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-6"
              aria-hidden="true"
            >
              {tab.ikon === 'rumah' && (
                <path d="M3.6 10.4 12 3.4l8.4 7v9a1.4 1.4 0 0 1-1.4 1.4h-3.6v-5.2a1.2 1.2 0 0 0-1.2-1.2H9.8a1.2 1.2 0 0 0-1.2 1.2v5.2H5A1.4 1.4 0 0 1 3.6 19.4Z" />
              )}
              {tab.ikon === 'katalog' && (
                <>
                  <rect x="3.4" y="3.4" width="7.4" height="7.4" rx="0.7" />
                  <rect x="13.2" y="3.4" width="7.4" height="7.4" rx="0.7" />
                  <rect x="3.4" y="13.2" width="7.4" height="7.4" rx="0.7" />
                  <rect x="13.2" y="13.2" width="7.4" height="7.4" rx="0.7" />
                </>
              )}
              {tab.ikon === 'chat' && (
                <path d="M4.4 5.4h15.2A1.6 1.6 0 0 1 21.2 7v7.4a1.6 1.6 0 0 1-1.6 1.6H9.6L5 19.1v-2.9h-.6A1.6 1.6 0 0 1 2.8 14.6V7a1.6 1.6 0 0 1 1.6-1.6Z" />
              )}
              {tab.ikon === 'roda' && (
                <>
                  <circle cx="12" cy="12" r="3.4" />
                  <path d="M12 3v3M12 18v3M21 12h-3M6 12H3M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1M18.4 18.4l-2.1-2.1M7.7 7.7 5.6 5.6" />
                </>
              )}
            </svg>
            <span>{tab.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  const nav = document.querySelector<HTMLElement>('.nav-bawah');
  const bagian = document.getElementById('katalog');

  /* `#katalog` cuma ada di Beranda, jadi sinkronisasi tab cuma perlu jalan di
     situ. Di halaman detail, state aktif dari server sudah benar. */
  if (nav && bagian) {
    const beranda = nav.querySelector('[data-tab="beranda"]');
    const katalog = nav.querySelector('[data-tab="katalog"]');
    const garis = new IntersectionObserver(
      ([masuk]) => {
        if (!masuk) return;
        beranda?.setAttribute('aria-current', masuk.isIntersecting ? 'false' : 'page');
        katalog?.setAttribute('aria-current', masuk.isIntersecting ? 'page' : 'false');
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    garis.observe(bagian);
  }
</script>