---
import { ambilSite } from '../lib/db';
import { inisial } from '../data/site';

const site = ambilSite();

const NAV = [
  { label: 'Beranda', href: '/' },
  { label: 'Katalog', href: '/#katalog' },
] as const;
---

<header class="border-b border-garis bg-dasar">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <a href="/" class="target-sentuh flex items-center gap-2" aria-label="Beranda">
      <span class="flex size-9 items-center justify-center rounded-md bg-stone-900 font-sans text-sm font-bold text-white">
        {inisial(site.nama)}
      </span>
      <span class="text-base font-bold tracking-tight text-stone-900">{site.nama}</span>
    </a>
    <nav class="flex items-center gap-1" aria-label="Navigasi utama">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class="target-sentuh inline-flex items-center rounded-md px-3 text-sm font-medium text-stone-600 hover:bg-stone-100 hover:text-aksi-teks"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>