---
import { ambilSite } from '../lib/db';
import { linkWa } from '../data/site';
import { bacaSesi, COOKIE_ADMIN, COOKIE_AKUN } from '../lib/auth';

const site = ambilSite();
const wa = linkWa(undefined, site.whatsapp, site.nama);
const admin = bacaSesi(Astro.cookies, COOKIE_ADMIN, 'admin');
const seller = bacaSesi(Astro.cookies, COOKIE_AKUN, 'seller');
---

<footer class="border-t border-garis bg-dasar">
  <div class="mx-auto flex max-w-5xl flex-col gap-6 px-4 py-10 sm:px-6">
    <div class="flex flex-col gap-2">
      <p class="text-sm font-bold text-stone-900">{site.namaLengkap}</p>
      <p class="max-w-md text-sm text-stone-600 prosa">{site.deskripsi}</p>
    </div>
    {
      (admin || seller) && (
        <div class="border-t border-garis pt-6">
          <p class="text-sm font-bold text-stone-900">{admin ? 'Untuk pemilik' : 'Toko Anda'}</p>
          <nav aria-label={admin ? 'Menu pemilik' : 'Menu penjual'} class="mt-2 flex flex-wrap gap-2">
            {admin ? (
              <>
                <a
                  href="/admin"
                  class="target-sentuh inline-flex items-center rounded-md border border-garis px-3 font-medium text-stone-700 hover:bg-stone-100"
                >
                  Kelola katalog
                </a>
                <a
                  href="/admin/pengaturan"
                  class="target-sentuh inline-flex items-center rounded-md border border-garis px-3 font-medium text-stone-700 hover:bg-stone-100"
                >
                  Identitas toko
                </a>
              </>
            ) : (
              <>
                <a
                  href="/akun"
                  class="target-sentuh inline-flex items-center rounded-md border border-garis px-3 font-medium text-stone-700 hover:bg-stone-100"
                >
                  Produk saya
                </a>
                <a
                  href="/akun/toko"
                  class="target-sentuh inline-flex items-center rounded-md border border-garis px-3 font-medium text-stone-700 hover:bg-stone-100"
                >
                  Setelan toko
                </a>
              </>
            )}
          </nav>
        </div>
      )
    }
    <div class="flex flex-col gap-2 border-t border-garis pt-6 text-sm text-stone-600 sm:flex-row sm:items-center sm:justify-between">
      <p>
        Unit dijual oleh penjual independen. Kondisi setiap unit dijelaskan apa adanya di halamannya.
      </p>
      {
        wa && (
          <a
            href={wa}
            class="target-sentuh inline-flex items-center self-start rounded-md px-3 font-medium text-stone-600 hover:bg-stone-100 hover:text-aksi-teks sm:self-auto"
          >
            Tanya lewat WhatsApp
          </a>
        )
      }
    </div>
  </div>
</footer>
