---
interface Props {
  judul?: string;
  teks?: string;
}

const { judul = 'Halaman ini tidak ada.', teks = 'Alamat yang kamu buka tidak ditemukan. Kembali ke katalog untuk lihat unit yang tersedia.' } =
  Astro.props;
---

<section class="seks-luas mx-auto flex max-w-5xl flex-col items-center gap-4 px-4 text-center sm:px-6">
  <p class="text-sm font-bold tracking-wide text-aksi-teks">404</p>
  <h1 class="judul-hero text-stone-900">{judul}</h1>
  <p class="max-w-md text-base text-stone-600 prosa">{teks}</p>
  <a
    href="/#katalog"
    class="inline-flex items-center justify-center rounded-md bg-aksi px-5 py-3 text-sm font-semibold text-white hover:bg-emerald-800"
  >
    Lihat katalog
  </a>
</section>