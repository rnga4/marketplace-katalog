---
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';

import { bacaSesi, COOKIE_AKUN } from '../lib/auth';
import { ambilLapak, type Pengguna } from '../lib/db';
import { fotoSrc } from '../lib/foto';
import Kembali from '../components/Kembali.astro';
import NavBawah from '../components/NavBawah.astro';

interface Props {
  title: string;
  pengguna: Pengguna;
  notif?: { jenis: 'ok' | 'err'; teks: string } | null;
  kembali?: { href: string; label: string } | null;
}

const { title, pengguna, notif = null, kembali = null } = Astro.props;
const sesi = Astro.locals.pengguna ?? pengguna;
const lapak = ambilLapak(sesi.id);
const sesiAkun = bacaSesi(Astro.cookies, COOKIE_AKUN, 'seller');
const csrf = sesiAkun?.csrf ?? '';
const aktif = Astro.url.pathname.replace(/\/$/, '') || '/akun';
const namaToko = lapak?.nama ?? 'Toko saya';
// Tautan identitas menuju /akun. Saat tombol kembali sudah menuju /akun juga,
// keduanya jadi jalur yang sama, jadi identitas disembunyikan agar tidak ganda.
const tampilIdentitas = !kembali || kembali.href !== '/akun';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Toko saya</title>
    <link rel="icon" type="image/png+xml" href="/favicon.png" />
  </head>
  <body class="bg-dasar font-sans text-stone-900 antialiased">
    <header class="border-b border-garis bg-dasar">
      <div class="mx-auto flex max-w-5xl flex-col gap-2 px-4 py-3 sm:px-6 md:flex-row md:items-center md:justify-between md:gap-3">
        <div class="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-1">
          {kembali && <Kembali href={kembali.href} label={kembali.label} />}
          {
            tampilIdentitas && (
              <a href="/akun" class="target-sentuh flex min-w-0 items-center gap-2">
                {lapak?.foto ? (
                  <img
                    src={fotoSrc(lapak.foto, 'thumb')}
                    alt=""
                    width={32}
                    height={32}
                    class="size-8 shrink-0 rounded-md border border-garis bg-stone-100 object-cover"
                  />
                ) : (
                  <span class="flex size-8 shrink-0 items-center justify-center rounded-md bg-stone-900 font-sans text-xs font-bold text-white">
                    {sesi.nama.slice(0, 2).toUpperCase()}
                  </span>
                )}
                <span class="truncate text-sm font-bold tracking-tight text-stone-900">{namaToko}</span>
              </a>
            )
          }
        </div>
        <nav class="flex flex-wrap items-center gap-1 md:ml-auto" aria-label="Navigasi toko">
          <a
            href="/akun"
            aria-current={aktif === '/akun' ? 'page' : 'false'}
            class="target-sentuh inline-flex items-center rounded-md px-2.5 text-xs font-medium text-stone-600 hover:bg-stone-100 hover:text-aksi-teks"
          >
            Produk saya
          </a>
          <a
            href="/akun/tambah"
            aria-current={aktif === '/akun/tambah' ? 'page' : 'false'}
            class="target-sentuh inline-flex items-center rounded-md px-2.5 text-xs font-medium text-stone-600 hover:bg-stone-100 hover:text-aksi-teks"
          >
            Tambah produk
          </a>
          <a
            href="/akun/toko"
            aria-current={aktif === '/akun/toko' ? 'page' : 'false'}
            class="target-sentuh inline-flex items-center rounded-md px-2.5 text-xs font-medium text-stone-600 hover:bg-stone-100 hover:text-aksi-teks"
          >
            Setelan toko
          </a>
          <form method="post" action="/akun/keluar">
            <input type="hidden" name="csrf" value={csrf} />
            <button
              type="submit"
              class="target-sentuh inline-flex items-center rounded-md px-2.5 text-xs font-semibold text-stone-900 hover:bg-stone-100 hover:text-red-800"
            >
              Keluar
            </button>
          </form>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
      {
        notif && (
          <div
            class={`mb-6 rounded-md border px-4 py-3 text-sm ${
              notif.jenis === 'ok'
                ? 'border-emerald-700 bg-emerald-50 text-emerald-900'
                : 'border-red-700 bg-red-50 text-red-900'
            }`}
            role="status"
          >
            {notif.teks}
          </div>
        )
      }
      <slot />
    </main>
    <NavBawah />
  </body>
</html>

<script>
  if (document.querySelector('[role="status"]')) window.scrollTo(0, 0);
</script>