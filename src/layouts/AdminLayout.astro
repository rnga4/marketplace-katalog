---
import '../styles/global.css';

import { bacaSesi } from '../lib/auth';
import { jumlahAntrean, jumlahSellerMenunggu } from '../lib/db';
import Kembali from '../components/Kembali.astro';

interface Props {
  title: string;
  notif?: { jenis: 'ok' | 'err'; teks: string } | null;
  /** Daftar unit adalah akar admin, jadi halaman itu tidak punya tombol kembali. */
  kembali?: { href: string; label: string } | null;
}

const { title } = Astro.props;
const notif = Astro.props.notif ?? null;
const kembali = Astro.props.kembali ?? null;
const sesi = await bacaSesi(Astro.cookies);
// Dua angka ini datang dari dua tabel berbeda, jadi dijumlahkan setelah keduanya
// selesai — bukan `await jumlahAntrean().menunggu`, yang akan menunggu angka
// biasa dan tidak menunggu query-nya.
const [antreanUnit, antreanSeller] = await Promise.all([jumlahAntrean(), jumlahSellerMenunggu()]);
const totalAntrean = antreanUnit.menunggu + antreanSeller;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Admin</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body>
    <header class="border-b border-garis bg-dasar">
      <div class="mx-auto flex max-w-5xl flex-col gap-2 px-4 py-3 sm:px-6 md:flex-row md:items-center md:justify-between md:gap-3">
        {
          kembali ? (
            <Kembali href={kembali.href} label={kembali.label} />
          ) : (
            <a href="/admin" class="target-sentuh flex min-w-0 items-center gap-2 self-start">
              <span class="flex size-8 shrink-0 items-center justify-center rounded-md bg-stone-900 font-sans text-xs font-bold text-white">
                HP
              </span>
              <span class="truncate text-sm font-bold tracking-tight text-stone-900">Admin katalog</span>
            </a>
          )
        }
        <nav class="flex flex-wrap items-center gap-1 md:ml-auto" aria-label="Navigasi admin">
          <a
            href="/katalog"
            target="_blank"
            rel="noopener"
            class="target-sentuh inline-flex items-center rounded-md px-2.5 text-xs font-medium text-stone-600 hover:bg-stone-100 hover:text-aksi-teks"
          >
            Lihat katalog publik
          </a>
          <a
            href="/admin/moderasi"
            class="target-sentuh inline-flex items-center gap-1.5 rounded-md px-2.5 text-xs font-medium text-stone-600 hover:bg-stone-100 hover:text-aksi-teks"
          >
            Moderasi
            {
              totalAntrean > 0 && (
                <span class="rounded-md bg-amber-100 px-1.5 text-xs font-semibold text-amber-900">
                  {totalAntrean}
                </span>
              )
            }
          </a>
          <a
            href="/admin/tambah"
            class="target-sentuh inline-flex items-center rounded-md px-2.5 text-xs font-medium text-stone-600 hover:bg-stone-100 hover:text-aksi-teks"
          >
            Tambah unit
          </a>
          <a
            href="/admin/pengaturan"
            class="target-sentuh inline-flex items-center rounded-md px-2.5 text-xs font-medium text-stone-600 hover:bg-stone-100 hover:text-aksi-teks"
          >
            Identitas toko
          </a>
          <a
            href="/admin/pengumuman"
            class="target-sentuh inline-flex items-center rounded-md px-2.5 text-xs font-medium text-stone-600 hover:bg-stone-100 hover:text-aksi-teks"
          >
            Pengumuman
          </a>
          <a
            href="/admin/ubah-sandi"
            class="target-sentuh inline-flex items-center rounded-md px-2.5 text-xs font-medium text-stone-600 hover:bg-stone-100 hover:text-aksi-teks"
          >
            Ubah kata sandi
          </a>
          <form method="post" action="/admin/logout">
            <input type="hidden" name="csrf" value={sesi?.csrf ?? ''} />
            <button
              type="submit"
              class="target-sentuh inline-flex items-center rounded-md px-2.5 text-xs font-semibold text-stone-900 hover:bg-stone-100 hover:text-red-800"
            >
              Keluar
            </button>
          </form>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
      {
        notif && (
          <div
            class={`mb-6 rounded-md border px-4 py-3 text-sm ${
              notif.jenis === 'ok'
                ? 'border-emerald-700 bg-emerald-50 text-emerald-900'
                : 'border-red-700 bg-red-50 text-red-900'
            }`}
            role="status"
          >
            {notif.teks}
          </div>
        )
      }
      <slot />
    </main>
  </body>
</html>

<script>
  /* Setelah aksi (ada pesan di atas) pembacaan dimulai dari pesannya.
     Saat konfirmasi hapus, biarkan halaman yang mengatur posisi gulirnya sendiri. */
  if (document.querySelector('[role="status"]')) window.scrollTo(0, 0);
</script>