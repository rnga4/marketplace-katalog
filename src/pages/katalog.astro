---
import BaseLayout from '../layouts/BaseLayout.astro';
import { katalogUnit, listLapakTersedia, ambilSite } from '../lib/db';
import { linkWa } from '../data/site';
import UnitHpCard from '../components/UnitHpCard.astro';
import Paginasi from '../components/Paginasi.astro';

const q = Astro.url.searchParams;
const cari = (q.get('cari') ?? '').trim().slice(0, 80);
const lapak = (q.get('lapak') ?? '').trim().slice(0, 80);
const halaman = Number.parseInt(q.get('halaman') ?? '1', 10) || 1;

const hasil = katalogUnit({ cari, lapak, halaman });
const sellerTersedia = listLapakTersedia();
const site = ambilSite();
const waUmum = linkWa(undefined, site.whatsapp, site.nama);
const sellerDipilih = sellerTersedia.find((l) => l.slug === lapak) ?? null;
const adaFilter = cari !== '' || lapak !== '';

// Kartu katalog tidak punya penanda "Terjual" (lihat DESIGN.md), jadi katalog
// publik hanya menampilkan unit yang masih tersedia.
---

<BaseLayout
  title={sellerDipilih ? `Katalog ${sellerDipilih.nama}` : 'Katalog'}
  description="Semua unit HP bekas yang sedang tersedia, diurutkan dari yang paling murah. Kondisi tiap unit dijelaskan apa adanya di halaman detailnya."
>
  <section class="seks-luas mx-auto max-w-5xl px-4 sm:px-6">
    <div class="grid gap-8 border-b border-garis pb-10 md:grid-cols-[1.4fr_1fr] md:gap-12">
      <div class="flex flex-col gap-4">
        <h1 class="judul-hero text-stone-900">
          {sellerDipilih ? `Katalog ${sellerDipilih.nama}` : 'Katalog'}
        </h1>
        <p class="max-w-xl text-base text-stone-600 prosa">
          Paling murah dulu. Setiap unit ditulis detail: kondisi fisik, baterai, dan
          kekurangannya. Cek halaman unit lalu tanya lewat WhatsApp.
        </p>
      </div>
      <div class="flex flex-col justify-end gap-3 md:text-right">
        {
          !adaFilter && (
            <p class="text-sm text-stone-600">{hasil.total} unit tersedia saat ini.</p>
          )
        }
        {
          waUmum && (
            <a
              href={waUmum}
              class="target-sentuh inline-flex w-full items-center justify-center rounded-md bg-aksi px-5 text-sm font-semibold text-white hover:bg-emerald-800 md:w-auto"
            >
              Tanya stok terbaru
            </a>
          )
        }
      </div>
    </div>
  </section>

  <section class="seks-luas mx-auto max-w-5xl px-4 sm:px-6">
    <div class="mb-6 flex flex-col gap-4">
      <div>
        <h2 class="kepala-seksi text-stone-900">Cari unit</h2>
        <p class="text-sm text-stone-600">
          {
            adaFilter
              ? `${hasil.total} unit tersedia cocok dengan filter ini.`
              : 'Ketik nama, merek, atau besaran storage, atau saring dari satu penjual saja.'
          }
        </p>
      </div>

      <form method="get" action="/katalog" class="flex flex-col gap-3 sm:flex-row">
        <div class="flex-1">
          <label for="cari" class="sr-only">Cari unit</label>
          <input
            id="cari"
            type="search"
            name="cari"
            value={cari}
            maxlength="80"
            placeholder="Cari nama, merek, atau storage"
            class="target-sentuh w-full rounded-md border border-stone-500 bg-dasar px-3 py-2.5 text-sm text-stone-900 placeholder:text-stone-500 focus:border-aksi-teks focus:outline-none"
          />
        </div>
        <div class="sm:w-56">
          <label for="lapak" class="sr-only">Saring penjual</label>
          <select
            id="lapak"
            name="lapak"
            class="target-sentuh w-full rounded-md border border-stone-500 bg-dasar px-3 py-2.5 text-sm text-stone-900 focus:border-aksi-teks focus:outline-none"
          >
            <option value="">Semua penjual</option>
            {sellerTersedia.map((l) => (
              <option value={l.slug} selected={l.slug === lapak}>
                {l.nama} ({l.jumlah})
              </option>
            ))}
          </select>
        </div>
        <button
          type="submit"
          class="target-sentuh rounded-md border border-stone-300 bg-dasar px-5 py-2.5 text-sm font-semibold text-stone-900 hover:bg-stone-100"
        >
          Terapkan
        </button>
      </form>

      {
        adaFilter && (
          <p class="text-sm text-stone-600">
            <a href="/katalog" class="target-sentuh text-aksi-teks inline-flex items-center underline">
              Hapus filter
            </a>
          </p>
        )
      }
    </div>

    {
      hasil.unit.length > 0 ? (
        <>
          <div class="tutup-bidang grid grid-cols-2 gap-0 border-t border-l border-garis md:grid-cols-3 lg:grid-cols-4">
            {hasil.unit.map((unit, i) => (
              <UnitHpCard unit={unit} urut={i} penjualNama={unit.penjualNama} />
            ))}
          </div>
          <Paginasi
            halaman={hasil.halaman}
            jumlahHalaman={hasil.jumlahHalaman}
            cari={cari}
            lapak={lapak}
          />
        </>
      ) : (
        <div class="rounded-md border border-garis bg-stone-100 p-10 text-center">
          <p class="font-semibold text-stone-900">
            {adaFilter ? 'Tidak ada unit yang cocok.' : 'Belum ada unit yang tayang.'}
          </p>
          <p class="mt-1 text-sm text-stone-600">
            {
              adaFilter
                ? 'Coba kata kunci lain, atau saring semua penjual.'
                : 'Semua unit sedang habis atau belum ditinjau.'
            }
          </p>
          {adaFilter && (
            <a
              href="/katalog"
              class="target-sentuh mt-4 inline-flex items-center rounded-md border border-stone-300 px-4 text-sm font-semibold text-stone-900 hover:bg-stone-100"
            >
              Hapus filter
            </a>
          )}
        </div>
      )
    }
  </section>
</BaseLayout>
