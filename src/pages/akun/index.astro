---
import AkunLayout from '../../layouts/AkunLayout.astro';
import {
  listUnitsPemilik,
  ambilLapak,
  hitungKlik,
  LABEL_MODERASI,
  hargaTercoret,
  type Moderasi,
} from '../../lib/db';
import { fotoSrc } from '../../lib/foto';
import { rupiah } from '../../lib/format';
import { bacaSesi, COOKIE_AKUN } from '../../lib/auth';

const pengguna = Astro.locals.pengguna!;
const sesiAkun = await bacaSesi(Astro.cookies, COOKIE_AKUN, 'seller');
const semua = await listUnitsPemilik(pengguna.id);
const lapak = await ambilLapak(pengguna.id);
const klik = await hitungKlik(30);

const notifMap: Record<string, { jenis: 'ok' | 'err'; teks: string }> = {
  tersimpan: { jenis: 'ok', teks: 'Produk dikirim untuk ditinjau.' },
  diubah: { jenis: 'ok', teks: 'Perubahan produk dikirim untuk ditinjau lagi.' },
  terhapus: { jenis: 'ok', teks: 'Produk dihapus dari toko kamu.' },
  statusubah: { jenis: 'ok', teks: 'Status unit diperbarui.' },
  salahfasilitas: { jenis: 'err', teks: 'Permintaan ditolak (token sesi tidak cocok).' },
};
const notif = notifMap[Astro.url.searchParams.get('notif') ?? ''] ?? null;

const menunggu = semua.filter((u) => u.moderasi === 'menunggu').length;
const tayang = semua.filter((u) => u.moderasi === 'tayang').length;
const ditolak = semua.filter((u) => u.moderasi === 'tolak').length;
const totalNilai = semua
  .filter((u) => u.moderasi === 'tayang' && u.tersedia)
  .reduce((sum, u) => sum + (u.harga ?? 0), 0);

const hapusSlug = Astro.url.searchParams.get('hapus');
const unitHapus = hapusSlug ? semua.find((u) => u.slug === hapusSlug) ?? null : null;

function warna(m: Moderasi): string {
  if (m === 'tayang') return 'border-emerald-700 bg-emerald-50 text-emerald-900';
  if (m === 'tolak') return 'border-red-700 bg-red-50 text-red-900';
  return 'border-amber-700 bg-amber-50 text-amber-900';
}
---

<AkunLayout title="Produk saya" pengguna={pengguna} notif={notif}>
  <header class="mb-6 flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-xl font-bold tracking-tight text-stone-900">Produk saya</h1>
      <p class="mt-1 text-sm text-stone-600">
        Produk baru masuk antrean peninjauan sebelum muncul di katalog. {
          lapak && <a href={`/lapak/${lapak.slug}`} class="font-medium text-aksi-teks underline">Lihat lapak publik</a>
        }
      </p>
    </div>
    <a href="/akun/tambah" class="target-sentuh inline-flex shrink-0 items-center rounded-md bg-aksi px-4 text-sm font-semibold text-white hover:bg-emerald-800">
      + Tambah produk
    </a>
  </header>

  {
    semua.length > 0 && (
      <dl class="mb-6 grid grid-cols-2 gap-2 sm:grid-cols-4 sm:gap-4">
        <div class="rounded-md border border-garis px-3 py-2 sm:px-4 sm:py-3">
          <dt class="text-xs text-stone-600">Tayang</dt>
          <dd class="text-lg font-bold text-stone-900 sm:text-xl">{tayang}</dd>
        </div>
        <div class="rounded-md border border-garis px-3 py-2 sm:px-4 sm:py-3">
          <dt class="text-xs text-stone-600">Menunggu</dt>
          <dd class="text-lg font-bold text-stone-900 sm:text-xl">{menunggu}</dd>
        </div>
        <div class="rounded-md border border-garis px-3 py-2 sm:px-4 sm:py-3">
          <dt class="text-xs text-stone-600">Ditolak</dt>
          <dd class="text-lg font-bold text-stone-900 sm:text-xl">{ditolak}</dd>
        </div>
        <div class="rounded-md border border-garis px-3 py-2 sm:px-4 sm:py-3">
          <dt class="text-xs text-stone-600">Nilai Aset Tayang</dt>
          <dd class="truncate text-lg font-bold text-stone-900 sm:text-xl" title={rupiah(totalNilai)}>
            {totalNilai > 0 ? rupiah(totalNilai) : 'Rp0'}
          </dd>
        </div>
      </dl>
    )
  }

  {
    semua.length > 5 && (
      <div class="mb-4">
        <label for="filter-produk-seller" class="sr-only">Cari produk saya</label>
        <input
          id="filter-produk-seller"
          type="search"
          placeholder="Cari produk di tokomu (nama, merek, harga...)"
          class="target-sentuh w-full rounded-md border border-stone-400 bg-dasar px-3 text-sm text-stone-900 placeholder:text-stone-500 focus:border-aksi-teks focus:outline-none"
        />
      </div>
    )
  }

  {
    semua.length === 0 ? (
      <div class="rounded-md border border-dashed border-garis px-4 py-10 text-center">
        <p class="text-sm font-medium text-stone-900">Belum ada produk</p>
        <p class="mt-1 text-sm text-stone-600">Tambahkan unit HP yang ingin kamu jual. Setelah dikirim, produknya ditinjau dulu sebelum tayang.</p>
      </div>
    ) : (
      <ul id="daftar-produk-seller" class="flex flex-col gap-3">
        {semua.map((u) => {
          const coret = hargaTercoret(u);
          const sedangKonfirmasi = unitHapus?.slug === u.slug;
          return (
            <li class="flex gap-3 rounded-md border border-garis p-3">
              <img
                src={u.foto[0] ? fotoSrc(u.foto[0], 'thumb') : '/favicon.png'}
                alt=""
                width={80}
                height={80}
                loading="lazy"
                class="size-20 shrink-0 rounded-md border border-garis bg-stone-100 object-cover"
              />
              <div class="flex min-w-0 flex-1 flex-col gap-1">
                {sedangKonfirmasi && (
                  <div
                    id="konfirmasi-hapus"
                    role="alert"
                    class="mb-1 rounded-md border border-red-700 bg-red-50 px-3 py-3"
                  >
                    <p class="text-sm font-semibold text-red-900">Hapus “{u.nama}” dari toko kamu?</p>
                    <p class="mt-1 text-sm text-red-800">Ini menghapus produk beserta semua fotonya, dan tidak bisa dibatalkan.</p>
                    <div class="mt-3 flex gap-3">
                      <form method="post" action="/akun/hapus">
                        <input type="hidden" name="csrf" value={sesiAkun?.csrf ?? ""} />
                        <input type="hidden" name="slug" value={u.slug} />
                        <button type="submit" class="target-sentuh inline-flex items-center rounded-md bg-red-700 px-4 text-sm font-semibold text-white hover:bg-red-800">
                          Ya, hapus
                        </button>
                      </form>
                      <a href="/akun" class="target-sentuh inline-flex items-center rounded-md border border-stone-300 px-4 text-sm font-semibold text-stone-900 hover:bg-stone-100">
                        Batal
                      </a>
                    </div>
                  </div>
                )}
                <div class="flex flex-wrap items-start justify-between gap-2">
                  <div class="min-w-0">
                    <p class="truncate text-sm font-semibold text-stone-900">{u.nama}</p>
                    <p class="text-xs text-stone-600">
                      {rupiah(u.harga)}{coret && <span class="ml-1 line-through">{rupiah(coret)}</span>}
                      {klik[u.slug] ? ` · ${klik[u.slug]} klik WA (30 hari)` : ''}
                    </p>
                  </div>
                  <div class="flex shrink-0 flex-wrap items-center justify-end gap-2">
                    <span class={`rounded-md border px-2 py-0.5 text-xs font-medium ${warna(u.moderasi)}`}>
                      {LABEL_MODERASI[u.moderasi]}
                    </span>
                    <span class={`text-xs font-semibold ${u.tersedia ? 'text-aksi-teks' : 'text-stone-500'}`}>
                      {u.tersedia ? 'Tersedia' : 'Terjual'}
                    </span>
                  </div>
                </div>
                {u.moderasi === 'tolak' && u.alasanModerasi && (
                  <p class="text-xs text-red-800">Alasan ditolak: {u.alasanModerasi}</p>
                )}
                <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
                  <form method="post" action="/akun/tersedia">
                    <input type="hidden" name="csrf" value={sesiAkun?.csrf ?? ''} />
                    <input type="hidden" name="slug" value={u.slug} />
                    <button
                      type="submit"
                      aria-label={u.tersedia ? `Tandai ${u.nama} sebagai terjual` : `Tandai ${u.nama} tersedia`}
                      class={`target-sentuh inline-flex min-w-11 items-center justify-center font-medium underline ${u.tersedia ? 'text-stone-600' : 'text-aksi-teks'}`}
                    >
                      {u.tersedia ? 'Tandai terjual' : 'Tandai tersedia'}
                    </button>
                  </form>
                  <a href={`/akun/edit/${u.slug}`} class="target-sentuh inline-flex min-w-11 items-center justify-center font-medium text-aksi-teks underline">Ubah</a>
                  {u.moderasi === 'tayang' && (
                    <a href={`/hp/${u.slug}`} class="target-sentuh inline-flex items-center font-medium text-stone-600 underline">Lihat halaman</a>
                  )}
                  <a href={`/akun?hapus=${u.slug}`} class="target-sentuh inline-flex min-w-11 items-center justify-center font-medium text-red-800 underline">Hapus</a>
                </div>
              </div>
            </li>
          );
        })}
      </ul>
    )
  }
</AkunLayout>

{unitHapus && (
  <script>
    const panel = document.getElementById('konfirmasi-hapus');
    if (panel) {
      panel.scrollIntoView({ block: 'center' });
      panel.querySelector('button')?.focus();
    }
  </script>
)}

<script>
  const filterInput = document.getElementById('filter-produk-seller') as HTMLInputElement | null;
  if (filterInput) {
    const listItems = document.querySelectorAll<HTMLElement>('#daftar-produk-seller > li');
    filterInput.addEventListener('input', () => {
      const q = filterInput.value.toLowerCase().trim();
      for (const item of listItems) {
        const teks = item.textContent?.toLowerCase() ?? '';
        item.style.display = teks.includes(q) ? '' : 'none';
      }
    });
  }
</script>