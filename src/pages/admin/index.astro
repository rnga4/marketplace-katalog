---
import AdminLayout from '../../layouts/AdminLayout.astro';
import {
  listSemuaUnits,
  listAntrean,
  jumlahAntrean,
  jumlahSellerMenunggu,
  getUnit,
  deleteUnit,
  setTersedia,
  labelKondisi,
  LABEL_MODERASI,
  hargaTercoret,
  ambilSite,
  hitungKlik,
} from '../../lib/db';
import { rupiah } from '../../lib/format';
import { fotoSrc, hapusFoto } from '../../lib/foto';
import { waValid } from '../../data/site';
import { cekCsrf, teksForm, NOTIF } from '../../lib/forms';
import { bacaSesi } from '../../lib/auth';

const sesi = bacaSesi(Astro.cookies);
const csrf = sesi?.csrf ?? '';

let notif = Astro.url.searchParams.get('notif');

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  if (!cekCsrf(fd, sesi)) {
    notif = 'salahfasilitas';
  } else {
    const aksi = teksForm(fd, 'aksi');
    const slug = teksForm(fd, 'slug');
    const unit = slug ? getUnit(slug) : null;
    if (aksi === 'toggle' && unit) {
      setTersedia(slug, !unit.tersedia);
      return Astro.redirect('/admin?notif=statusubah');
    }
    if (aksi === 'hapus' && unit) {
      unit.foto.forEach(hapusFoto);
      deleteUnit(slug);
      return Astro.redirect('/admin?notif=terhapus');
    }
    return Astro.redirect('/admin');
  }
}

const semua = listSemuaUnits();
// Nama penjual untuk semua unit milik seller, diambil lewat join per status
// supaya daftar ini tidak melakukan satu query per unit.
const penjual = new Map(
  [...listAntrean('menunggu'), ...listAntrean('tayang'), ...listAntrean('tolak')].map((u) => [
    u.slug,
    u,
  ]),
);
const jmlAntrean = jumlahAntrean().menunggu;
const jmlSeller = jumlahSellerMenunggu();
const klik = hitungKlik(30);
const mintaHapus = Astro.url.searchParams.get('hapus');
const unitHapus = mintaHapus ? getUnit(mintaHapus) : null;
const infoNotif = notif ? NOTIF[notif] ?? null : null;
const waSiap = waValid(ambilSite().whatsapp);
---

<AdminLayout title="Unit" notif={infoNotif}>
  {
    !waSiap && (
      <div class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-md border border-amber-700 bg-dasar p-4">
        <p class="text-sm text-stone-700">
          Nomor WhatsApp belum diisi, jadi semua tombol WhatsApp di katalog disembunyikan.
        </p>
        <a
          href="/admin/pengaturan"
          class="target-sentuh inline-flex items-center rounded-md border border-stone-300 px-3 text-sm font-semibold text-stone-900 hover:bg-stone-100"
        >
          Isi sekarang
        </a>
      </div>
    )
  }

  {
    jmlSeller > 0 && (
      <a
        href="/admin/moderasi"
        class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-md border border-amber-700 bg-dasar px-4 py-3 hover:bg-amber-50"
      >
        <p class="text-sm text-stone-700">
          <span class="font-semibold text-stone-900">{jmlSeller} seller baru</span> menunggu persetujuan akun.
        </p>
        <span class="text-sm font-semibold text-aksi-teks">Buka moderasi</span>
      </a>
    )
  }

  {
    jmlAntrean > 0 && (
      <a
        href="/admin/moderasi"
        class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-md border border-amber-700 bg-dasar px-4 py-3 hover:bg-amber-50"
      >
        <p class="text-sm text-stone-700">
          <span class="font-semibold text-stone-900">{jmlAntrean} produk seller</span> menunggu review
          sebelum tayang.
        </p>
        <span class="text-sm font-semibold text-aksi-teks">Buka moderasi</span>
      </a>
    )
  }

  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-xl font-bold tracking-tight text-stone-900">Unit katalog</h1>
      <p class="text-sm text-stone-600">{semua.length} unit terpasang.</p>
    </div>
    <a
      href="/admin/tambah"
      class="target-sentuh inline-flex items-center rounded-md bg-aksi px-4 text-sm font-semibold text-white hover:bg-emerald-800"
    >
      Tambah unit
    </a>
  </div>

  {
    semua.length === 0 ? (
      <div class="rounded-md border border-garis bg-stone-100 p-10 text-center">
        <p class="font-semibold text-stone-900">Belum ada unit.</p>
        <p class="mt-1 text-sm text-stone-600">Mulai dengan menambah unit pertama.</p>
      </div>
    ) : (
      <ul class="flex flex-col divide-y divide-garis border-b border-t border-garis">
        {
          semua.map((unit) => {
            const coret = hargaTercoret(unit);
            const sedangKonfirmasi = unitHapus?.slug === unit.slug;
            return (
              <li class="py-3">
                {sedangKonfirmasi && (
                  <div
                    id="konfirmasi-hapus"
                    class="mb-3 rounded-md border border-red-700 bg-red-50 px-4 py-4"
                    role="alert"
                  >
                    <p class="text-sm font-semibold text-red-900">
                      Hapus “{unit.nama}” dari katalog?
                    </p>
                    <p class="mt-1 text-sm text-red-800">
                      Ini menghapus data unit beserta semua fotonya, dan tidak bisa dibatalkan.
                    </p>
                    <div class="mt-3 flex gap-3">
                      <form method="post" action="/admin">
                        <input type="hidden" name="csrf" value={csrf} />
                        <input type="hidden" name="aksi" value="hapus" />
                        <input type="hidden" name="slug" value={unit.slug} />
                        <button
                          type="submit"
                          class="target-sentuh inline-flex items-center rounded-md bg-red-700 px-4 text-sm font-semibold text-white hover:bg-red-800"
                        >
                          Ya, hapus
                        </button>
                      </form>
                      <a
                        href="/admin"
                        class="target-sentuh inline-flex items-center rounded-md border border-stone-300 px-4 text-sm font-semibold text-stone-900 hover:bg-stone-100"
                      >
                        Batal
                      </a>
                    </div>
                  </div>
                )}

                <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
                  {unit.foto[0] ? (
                    <img
                      src={fotoSrc(unit.foto[0], 'thumb')}
                      alt=""
                      class="size-14 shrink-0 rounded-md border border-garis bg-stone-100 object-cover"
                      loading="lazy"
                    />
                  ) : (
                    <span class="flex size-14 shrink-0 items-center justify-center rounded-md border border-garis bg-stone-100 px-1 text-center text-xs text-stone-600">
                      Tanpa foto
                    </span>
                  )}
                  <div class="min-w-40 flex-1">
                    <p class="truncate text-sm font-semibold text-stone-900">{unit.nama}</p>
                    <p class="text-xs text-stone-600">
                      {labelKondisi(unit.kondisi)} · {rupiah(unit.harga)}
                      {coret ? ` (coret ${rupiah(coret)})` : ''}
                      {klik[unit.slug] ? ` · ${klik[unit.slug]} klik WA (30 hari)` : ''}
                    </p>
                    {penjual.get(unit.slug) && (
                      <p class="mt-0.5 text-xs text-stone-600">
                        Penjual: <span class="font-medium text-stone-900">{penjual.get(unit.slug)?.sellerNama}</span>
                      </p>
                    )}
                  </div>
                  {unit.pemilikId !== null && (
                    <span class="rounded-md border border-garis bg-stone-100 px-2 py-0.5 text-xs font-semibold text-stone-600">
                      {LABEL_MODERASI[unit.moderasi]}
                    </span>
                  )}
                  <span class={`text-xs font-semibold ${unit.tersedia ? 'text-aksi-teks' : 'text-stone-500'}`}>
                    {unit.tersedia ? 'Tersedia' : 'Terjual'}
                  </span>
                  <div class="flex w-full items-center gap-2 sm:w-auto">
                    <form method="post" action="/admin" class="flex-1 sm:flex-none">
                      <input type="hidden" name="csrf" value={csrf} />
                      <input type="hidden" name="aksi" value="toggle" />
                      <input type="hidden" name="slug" value={unit.slug} />
                      <button
                        type="submit"
                        class={`target-sentuh inline-flex w-full items-center justify-center rounded-md border px-3 text-xs font-semibold ${unit.tersedia ? 'border-stone-300 text-stone-700 hover:border-stone-500' : 'border-aksi-teks text-aksi-teks hover:bg-emerald-50'}`}
                        aria-label={unit.tersedia ? `Tandai ${unit.nama} sebagai terjual` : `Tandai ${unit.nama} tersedia`}
                      >
                        {unit.tersedia ? 'Tandai terjual' : 'Tandai tersedia'}
                      </button>
                    </form>
                    <a
                      href={`/admin/edit/${unit.slug}`}
                      class="target-sentuh inline-flex flex-1 items-center justify-center rounded-md border border-stone-300 px-3 text-xs font-semibold text-stone-900 hover:border-stone-500 hover:bg-stone-100 sm:flex-none"
                    >
                      Edit
                    </a>
                    <a
                      href={`/admin?hapus=${unit.slug}`}
                      class="target-sentuh inline-flex flex-1 items-center justify-center rounded-md border border-transparent px-3 text-xs font-semibold text-red-800 hover:border-red-700 hover:bg-red-50 sm:flex-none"
                    >
                      Hapus
                    </a>
                  </div>
                </div>
              </li>
            );
          })
        }
      </ul>
    )
  }
</AdminLayout>

{
  unitHapus && (
    <script>
      const panel = document.getElementById('konfirmasi-hapus');
      if (panel) {
        panel.scrollIntoView({ block: 'center' });
        panel.querySelector('button')?.focus();
      }
    </script>
  )
}