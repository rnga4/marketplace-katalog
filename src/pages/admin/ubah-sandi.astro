---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { setKataSandi, cekKataSandi, ambilAdmin } from '../../lib/db';
import { bacaSesi, buatToken, cookieAman, COOKIE_ADMIN } from '../../lib/auth';
import { cekCsrf, teksForm } from '../../lib/forms';

const sesi = bacaSesi(Astro.cookies);

let galat: string | null = null;

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const sekarang = teksForm(fd, 'kataSandi');
  const baru = teksForm(fd, 'kataSandiBaru');
  const ulangi = teksForm(fd, 'kataSandiBaru2');
  if (!cekCsrf(fd, sesi)) {
    return Astro.redirect('/admin?notif=salahfasilitas');
  } else if (!(await cekKataSandi(sekarang))) {
    galat = 'Kata sandi saat ini salah.';
  } else if (baru.length < 8) {
    galat = 'Kata sandi baru minimal 8 karakter.';
  } else if (baru.length > 200) {
    galat = 'Kata sandi baru maksimal 200 karakter.';
  } else if (baru !== ulangi) {
    galat = 'Ulangi kata sandi tidak sama.';
  } else {
    setKataSandi(baru);
    // Versi sesi admin naik; terbitkan token baru supaya sesi ini tetap hidup
    // sementara token admin lama (mis. di perangkat lain) ikut dicabut.
    const adminBaru = ambilAdmin();
    if (adminBaru) {
      Astro.cookies.set(
        COOKIE_ADMIN,
        buatToken(adminBaru.id, 'admin', sesi?.csrf ?? '', adminBaru.sesiVersi),
        {
          path: '/',
          httpOnly: true,
          sameSite: 'lax',
          secure: cookieAman(Astro.request, Astro.url),
          maxAge: 7 * 24 * 60 * 60,
        },
      );
    }
    return Astro.redirect('/admin?notif=sandiubah');
  }
}

const csrf = sesi?.csrf ?? '';
---

<AdminLayout
  title="Ubah kata sandi"
  notif={galat ? { jenis: 'err', teks: galat } : null}
  kembali={{ href: '/admin', label: 'Unit katalog' }}
>
  <header class="mb-6">
    <h1 class="text-xl font-bold tracking-tight text-stone-900">Ubah kata sandi</h1>
    <p class="text-sm text-stone-600">Ganti kata sandi yang dipakai untuk masuk ke panel admin.</p>
  </header>

  <form method="post" action="/admin/ubah-sandi" class="flex max-w-md flex-col gap-4">
    <input type="hidden" name="csrf" value={csrf} />
    <label class="flex flex-col gap-1.5">
      <span class="text-sm font-medium text-stone-900">Kata sandi saat ini</span>
      <input type="password" name="kataSandi" required autocomplete="current-password" class="rounded-md border border-stone-300 bg-dasar px-3 py-2 text-sm focus:border-aksi-teks focus:outline-none" />
    </label>
    <label class="flex flex-col gap-1.5">
      <span class="text-sm font-medium text-stone-900">Kata sandi baru</span>
      <input type="password" name="kataSandiBaru" required minlength="8" autocomplete="new-password" class="rounded-md border border-stone-300 bg-dasar px-3 py-2 text-sm focus:border-aksi-teks focus:outline-none" />
    </label>
    <label class="flex flex-col gap-1.5">
      <span class="text-sm font-medium text-stone-900">Ulangi kata sandi baru</span>
      <input type="password" name="kataSandiBaru2" required minlength="8" autocomplete="new-password" class="rounded-md border border-stone-300 bg-dasar px-3 py-2 text-sm focus:border-aksi-teks focus:outline-none" />
    </label>
    <div class="flex items-center gap-3 border-t border-garis pt-4">
      <button type="submit" class="rounded-md bg-aksi px-5 py-2.5 text-sm font-semibold text-white hover:bg-emerald-800">
        Simpan kata sandi baru
      </button>
      <a href="/admin" class="rounded-md border border-stone-300 px-5 py-2.5 text-sm font-semibold text-stone-900 hover:bg-stone-100">
        Batal
      </a>
    </div>
  </form>
</AdminLayout>